# Reverse proxy + automatic HTTPS (Let's Encrypt) for Estúdio Pedra Industrial,
# designed to sit behind Cloudflare's proxy (orange cloud) with SSL mode
# "Full (strict)". Works without Cloudflare too.
#
# On the VPS (see DEPLOY.md step 6):
#   1. sed -i "s/DOMAIN/seudominio.com.br/g" deploy/Caddyfile
#   2. sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   3. sudo systemctl reload caddy
#
# The app listens on localhost:3000; Caddy terminates TLS and proxies to it.

{
	servers {
		# Trust Cloudflare's edge so {client_ip} is the visitor, not the edge.
		# Ranges from https://www.cloudflare.com/ips/ (check for updates yearly).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

DOMAIN {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Uploaded photos and built assets are content-addressed: cache forever.
	header /uploads/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy localhost:3000 {
		# The app runs with `trust proxy 1`, so hand it a single real client IP.
		header_up X-Forwarded-For {client_ip}
	}
}
