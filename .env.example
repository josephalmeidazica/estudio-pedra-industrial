# Bearer token (admin password) required for all write (admin) API endpoints.
# In production (NODE_ENV=production) the server REFUSES TO START without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Public address of the site, no trailing slash. Used for the absolute URLs in
# link previews (Open Graph), the sitemap and robots.txt. Set it in production;
# when unset the server falls back to the host of each request (fine for
# development and LAN testing).
SITE_URL=https://seudominio.com.br

# Optional overrides:
# PORT=3000
# DATABASE_PATH=.data/app.db
# UPLOADS_DIR=.data/uploads
