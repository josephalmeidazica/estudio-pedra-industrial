# Admin passphrase: what the owner types once at /admin to log in (the phone
# then stays logged in for 30 days). Also accepted as a bearer token on the
# API. Pick something long and easy to type on a phone — at least 12
# characters, e.g. three unrelated words with spaces:
#   ADMIN_PASSWORD=mesa ferro carvalho
# In production (NODE_ENV=production) the server REFUSES TO START without it.
# Changing it logs every device out (unless SESSION_SECRET is set, see below).
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Optional. Key that signs the 30-day login cookie. When unset it is derived
# from ADMIN_PASSWORD, so changing the passphrase signs everyone out. Set it
# (any long random string) if you want to change the passphrase without
# logging devices out; change IT to force every device to log in again.
# SESSION_SECRET=

# Public address of the site, no trailing slash. Used for the absolute URLs in
# link previews (Open Graph), the sitemap and robots.txt. Set it in production;
# when unset the server falls back to the host of each request (fine for
# development and LAN testing).
SITE_URL=https://seudominio.com.br

# Optional overrides:
# PORT=3000
# DATABASE_PATH=.data/app.db
# UPLOADS_DIR=.data/uploads
